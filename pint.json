{
    "preset": "psr12",
    "exclude": ["src/Generated"],
    "rules": {
        "declare_strict_types": true,
        "final_class": true,
        "strict_comparison": true,
        "strict_param": true,
        "no_unused_imports": true,
        "ordered_imports": { "sort_algorithm": "alpha" },
        "single_quote": true,
        "trailing_comma_in_multiline": { "elements": ["arguments", "arrays", "match", "parameters"] }
    }
}
